<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Tema" parent="Theme.MaterialComponents.Light.DarkActionBar">
        <item name="colorPrimary">@color/primario</item>
        <item name="colorPrimaryVariant">@color/primario_oscuro</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">@color/acento</item>
        <item name="colorOnSecondary">#FFFFFF</item>
        <item name="android:statusBarColor">@color/primario_oscuro</item>
        <item name="android:windowBackground">@color/fondo</item>
    </style>

    <style name="Tarjeta">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/fondo_tarjeta</item>
        <item name="android:padding">14dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="Etiqueta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto_suave</item>
        <item name="android:textSize">13sp</item>
        <item name="android:layout_marginTop">10dp</item>
    </style>

    <style name="TituloTarjeta">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">@color/texto</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginBottom">6dp</item>
    </style>
</resources>
